layout {

    focus-ring {
        active-color   "#8b9ac1"
        inactive-color "#1a1c23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#8b9ac1"
        inactive-color "#1a1c23"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#8b9ac1"
        inactive-color "#2f406a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#8b9ac180"
    }
}

recent-windows {
    highlight {
        active-color "#8b9ac1"
        urgent-color "#fd4663"
    }
}
