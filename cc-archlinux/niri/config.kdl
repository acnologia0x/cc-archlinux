

//=====>>OUTPUT
    //=====>>Laptop screen
    output "eDP-1" {
        mode "1920x1200@60.000"
        scale 1.0
        position x=1080 y=0
    }
    //<<=====Laptop Screen
    // //=====>>ASUSTek COMPUTER INC ASUS VG249Q1A R4LMTF071098: 1080p left side
    output "HDMI-A-1" {
         mode "1920x1080@60.000"
         scale 1.0
         position x=0 y=0
     }
    //<<=====ASUSTek COMPUTER INC ASUS VG249Q1A R4LMTF071098: 1080p left side
    // //=====>>Samsung Electric Company SAMSUNG 0x01000E00: on top
    // output "HDMI-A-1" {
    //     mode "1920x1080@60.000"
    //     scale 1.0
    //     position x=0 y=0
    // }
    // //<<=====Samsung Electric Company SAMSUNG 0x01000E00: 1080p placed on top
//<<=====OUTPUT
input{
    keyboard{
        xkb{
            layout "us, kh"
            options "grp:shift_caps_toggle"
        }
    }
	touchpad{
		tap
		natural-scroll
	}
}
config-notification {
    disable-failed
}
layout{
    // Set gaps around windows in logical pixels.
    gaps 12.5
    // When to center a column when changing focus, options are:
    // - "never", default behavior, focusing an off-screen column will keep at the left
    //   or right edge of the screen.
    // - "always", the focused column will always be centered.
    // - "on-overflow", focusing a column will center it if it doesn't fit
    //   together with the previously focused column.
    center-focused-column "never"
    preset-column-widths{
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    border{
        off
        width 1.5
        active-color   "#707070"      // Neutral gray
        inactive-color "#d0d0d0"      // Light gray
        urgent-color   "#cc4444"      // Softer red
    }

    focus-ring{
        width 2
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

}
//=====>> Noctalia Specific layer-rule & window-rule
overview {
    backdrop-color "#000000"
    workspace-shadow {
        off
    }
}
layer-rule{
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}
layer-rule{
//Background effects for Nocatalia Bar...
    match namespace="^noctalia-bar"
    background-effect{
        blur false
    }
}
window-rule{
// Floating Noctalia settings window.
    match app-id="dev.noctalia.Noctalia"
    open-floating false
}
//<<===== Noctalia Specific layer-rule & window-rule
// Add lines like this to spawn processes at startup.
spawn-at-startup "noctalia"
spawn-at-startup "easyeffects"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "mpd"
//=========>>COMMON WINDOWS RULES
prefer-no-csd
window-rule{
    geometry-corner-radius 4.9
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}
//<<=========COMMON WINDOWS RULES
//=========>>OTHER WINDOWS RULES
window-rule {
    match app-id="com.microsoft.VSCode"   
    opacity 0.75 // Adjust between 0.0 (invisible) and 1.0 (opaque)
    background-effect{
        blur true
    }
}

window-rule{
    match app-id="org.telegram.desktop"
    opacity 0.85
    draw-border-with-background false
    background-effect{
        blur true
    }
}

window-rule{
    match app-id="org.gnome.Nautilus"
    opacity 0.8
    draw-border-with-background false
    background-effect{
        blur true
    }
}

window-rule{
    match app-id="kitty"
    opacity 0.65
    draw-border-with-background false
    background-effect{
	    blur true
	}
}

window-rule{
    match app-id="tauonmb"
    draw-border-with-background false
    background-effect{
    blur false
    }
}

window-rule{
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule{
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 12
}

window-rule{
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}

window-rule{
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^xdg-desktop-portal$"#
    open-floating true
}
//<<=========OTHER WINDOWS RULES
xwayland-satellite {
    path "xwayland-satellite"
}

debug{
    // Allows notification actions and window activation from Noctalia.
    honor-xdg-activation-with-invalid-serial
}
recent-windows{
    binds{
        Alt+Tab     { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}
//Include noctalia files
include "noctalia.kdl" //The Color pallete that noctalia automanically changes acording to the wallpaper.
//Include my files
include "binds.kdl"
